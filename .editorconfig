# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Set default charset
charset = utf-8

trim_trailing_whitespace = true
indent_style = space

[export_units.txt]
charset = unset
end_of_line = crlf

[expanded_bi.txt]
charset = unset
end_of_line = crlf
